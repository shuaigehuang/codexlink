<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="codexlink.exe"
        Arguments=""
        InstallLocation="C:\Program Files\CodexLink\CodexLink">
    </Installer>
    <PackageInformation
        PackageName="CodexLink"
        PackageDisplayName="CodexLink"
        PublisherName="CN=CodexLink"
        PublisherDisplayName="CodexLink"
        Version="0.1.0.0"
        PackageDescription="Remote Codex and magpie control">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.codexlink.desktop"
                Description="Remote Codex and magpie control"
                DisplayName="CodexLink"
                ExecutableName="codexlink.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>CodexLink</DisplayName>
            <PublisherDisplayName>CodexLink</PublisherDisplayName>
            <Description>Remote Codex and magpie control</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="codexlink.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
